# `npm run setup` copies this file to `.env` (if none exists). `npm run dev`,
# `npm start` and `npm test` load `.env`; variables already set in your shell
# take precedence. Docker sets the container's variables in docker-compose.yml.

PORT=3000
NODE_ENV=development

